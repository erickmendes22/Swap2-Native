# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# coverage.py data and its JSON report (pyproject.toml, [tool.coverage.run])
.coverage
.coverage.*
/coverage.json
# Swap2-Native: local folders from before the restart (game dumps, old build outputs) - never committed
/Dump/
/MKW \[ROM\]/
/build/
/output/
/android/deps/
/android/mkwdroid/
/android/out/
/android/out-*.log
# Swap2-Native: working analyses of other projects and reviews (Portuguese, kept local, 2026-11-08)
/docs/ANALISE-*.md
/docs/REVISAO-*.md
/android/out-*.err
# scratch translator wrappers (local runs only)
/dm/gfx/tools/dmsh_xlate_bin/xrun_*.sh
